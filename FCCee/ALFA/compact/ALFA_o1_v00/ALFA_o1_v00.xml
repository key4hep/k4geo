<lccdd>

  <info name="ALFA_o1_v00"
    title="Master file for the ALFA detector concept"
    author="Various, Tracker by E.Ploerer, Grainita ECAL by F.Guo"
    url="no"
    status="development"
    version="o1_v00">
    <comment>
      Based on IDEA master file.
      Tracker corresponds to BAR354_EC353_VTX108 Delphes card.
    </comment>
  </info>

  <include ref="${DD4hepINSTALL}/DDDetectors/compact/detector_types.xml" />

  <comment> Material definitions </comment>
  <includes>
    <gdmlFile  ref="elements.xml"/>
    <gdmlFile  ref="materials.xml"/>
  </includes>

  <comment> World dimensions </comment>
  <define>
    <constant name="world_side"   value="20.0*m"/>
    <constant name="world_x"      value="world_side / 2.0"/>
    <constant name="world_y"      value="world_side / 2.0"/>
    <constant name="world_z"      value="world_side / 2.0"/>
  </define>

  <comment> Tracker dimensions </comment>
  <define>
    <constant name="tracker_region_zmax"   value="2.1*m"/>
    <constant name="tracker_region_rmax"      value="1.8*m"/>
  </define>

  <comment> Tracker bitfield </comment>
  <define>
    <constant name="GlobalTrackerReadoutID" type="string" value="system:5,side:-2,layer:5,module:13,sensor:7"/>
    <comment> Silicon barrel tracker has 5 (VTX) + 6*4 (OT) layers => min 5 bits. Silicon OT final layer has 112 * 2 * 21 modules / n ("layers" / physical double layer) => min 13 bits. Assume vertex barrel 60 pixel matrices per module (IDEA) => min 6 bits. </comment>
  </define>



  <comment> Shape-based beam pipe </comment>
  <include ref="MDI_params.xml" />
  <include ref="../../../MDI/compact/MDI_o1_v00/Beampipe_o4_v05.xml" />
  <include ref="../../../MDI/compact/MDI_o1_v00/BeamInstrumentation_o1_v01.xml" />

  <comment> Sub-detector definitions </comment>

  <comment> Outer Tracker (OT) Barrel  </comment>
  <include ref="OuterTrackerBarrel_o1_v00.xml" />

  <comment> Grainita ECAL </comment>
  <include ref="Grainita_ECAL_Barrel_o1_v02.xml" /> 

  <comment> Include plugin to generate edm4hep::TrackerHitPlane </comment>
  <plugins>
    <!-- <plugin name="DD4hepVolumeManager"/> -->
    <plugin name="InstallSurfaceManager"/>
  </plugins>

  <comment> Magnetic field constants </comment>
  <define>
    <constant name="Solenoid_field"   value="3.0*tesla"/>
    <constant name="Solenoid_coil_half_length"      value="2.0*m"/>
    <constant name="Solenoid_coil_outer_radius"      value="2.7*m"/>
  </define>

  <comment> Magnetic field definition </comment>
  <comment> Assume constant field for lt inner field and lt outer field (beyond coil) </comment>
  <fields>
    <field name="Solenoid" type="solenoid"
      inner_field="Solenoid_field"
      outer_field="-1.0*tesla"
      zmax="1.2 * Solenoid_coil_half_length"
      outer_radius="Solenoid_coil_outer_radius">
    </field>
  </fields>







</lccdd>
