<?xml version="1.0" encoding="UTF-8"?>
<materials>


  <material name="Vacuum">
    <D type="density" unit="g/cm3" value="0.0000000001" />
    <fraction n="0.754" ref="N"/>
    <fraction n="0.234" ref="O"/>
    <fraction n="0.012" ref="Ar"/>
  </material>

  <material name="Air">
    <D type="density" unit="g/cm3" value="0.0012"/>
    <fraction n="0.754" ref="N"/>
    <fraction n="0.234" ref="O"/>
    <fraction n="0.012" ref="Ar"/>
  </material>

  <material name="Water">
    <MEE unit="eV" value="78"/>
    <D type="density" value="1.0" unit="g/cm3" />
    <composite n="2" ref="H" />
    <composite n="1"  ref="O" />
  </material>

  <material name="Brass">
    <D type="density" unit="g/cm3" value="8.44" />
    <fraction n="0.7" ref="Cu" />
    <fraction n="0.3" ref="Zn" />
  </material>

  <comment> Beam Pipe Materials </comment>
  <material name="AlBeMet162">
    <D value="2.1" unit="g/cm3"/>
    <fraction n="0.38" ref="Al"/>
    <fraction n="0.62" ref="Be"/>
  </material>

  <material name="LiquidNDecane">
    <D value="0.73" unit="g/cm3"/>
    <composite n="10" ref="C" />
    <composite n="22" ref="H" />
  </material>


  <material name="beam" state="gas">
    <P unit="pascal" value="6.25e-06"/>
    <MEE unit="eV" value="38.5760755714278"/>
    <D unit="g/cm3" value="1.7e-14"/>
    <fraction n="0.36264" ref="H"/>
    <fraction n="0.36276" ref="N"/>
    <fraction n="0.117748421296248" ref="C"/>
    <fraction n="0.156851578703752" ref="O"/>
  </material>

  <material name="SolenoidMixture">
    <D value="4.38" unit="g/cm3"/>
    <fraction n="0.666" ref="Al"/>
    <fraction n="0.166" ref="Cu"/>
    <fraction n="0.084" ref="Ti"/>
    <fraction n="0.084" ref="Nb"/>
  </material>

  

  <comment> Outer Tracker Materials </comment>
  <material name="CarbonPaper">
    <D type="density" unit="g/cm3" value="1.6"/>
    <fraction n="1.0" ref="C"/>
  </material>

  <material name="CarbonFleece">
    <D type="density" unit="g/cm3" value="0.4"/>
    <fraction n="1.0" ref="C"/>
  </material>

  <material name="K13D2U">
    <D type="density" unit="g/cm3" value="1.0"/>
    <fraction n="1.0" ref="C"/>
  </material>

  <material name="Kapton">
    <D type="density" unit="g/cm3" value="1.42"/>
    <composite n="22" ref="C"/>
    <composite n="10" ref="H"/>
    <composite n="2"  ref="N"/>
    <composite n="5"  ref="O"/>
  </material>

  <material name="OpteonSF10">
    <D type="density" unit="g/cm3" value="1.58"/>
    <composite n="8"  ref="C"/>
    <composite n="3"  ref="H"/>
    <composite n="13" ref="F"/>
    <composite n="1"  ref="O"/>
  </material>
  <comment> https://tmcindustries.com/products/opteon-sf10?variant=32229492228163 </comment>

  <material name="FR3703">
    <D type="density" unit="g/cm3" value="0.048"/>
    <composite n="17" ref="C"/>
    <composite n="16" ref="H"/>
    <composite n="2"  ref="N"/>
    <composite n="4"  ref="O"/>
  </material>
  <comment> https://www.curbellplastics.com/product/w10-00064/ </comment>
  <comment> Chemical formula from repeating unit of Polyurethane </comment>

  <material name="FR3703_truss"> 
    <D type="density" unit="g/cm3" value="0.048 * 0.328"/> 
    <composite n="17" ref="C"/>
    <composite n="16" ref="H"/>
    <composite n="2"  ref="N"/>
    <composite n="4"  ref="O"/>
  </material>
  <comment> As above but the density is reduced by a fill factor 0.328 to account for Warren truss at side </comment>

  <material name="Epoxy">
    <D type="density" unit="g/cm3" value="1.16"/>
    <composite n="21" ref="C"/>
    <composite n="24" ref="H"/>
    <composite n="4"  ref="O"/>
  </material>
  <comment> https://pubchem.ncbi.nlm.nih.gov/compound/Epoxy-Resin#section=IUPAC-Name </comment>

  <material name="Coverlay">
    <D type="density" unit="g/cm3" value="1.20"/>
    <fraction n="0.50" ref="Kapton"/>
    <fraction n="0.50" ref="Epoxy"/>
  </material>

  <material name="Prepreg">
    <D type="density" unit="g/cm3" value="1.85"/>
    <fraction n="1.0" ref="Epoxy"/>
  </material>

</materials>

<comment> Grainita Materials </comment>
<properties>
  <!-- Default optical properties for the v02 mixed-grain material.
    These are intentionally simple placeholders for enabling optical
    photon production. They are only used when optical physics is enabled
    in the steering file. Replace them with measured Grainita values when
  available. -->
  <matrix name="RI_MixGrains_Default" coldim="2" values="
    1.0*eV 1.80
    6.0*eV 1.80
    "/>
  <matrix name="AbsLen_MixGrains_Default" coldim="2" values="
    1.0*eV 1.0*m
    6.0*eV 1.0*m
    "/>
  <matrix name="ScintFast_MixGrains_Default" coldim="2" values="
    1.5*eV 0.0
    2.8*eV 1.0
    4.5*eV 0.0
    "/>
</properties>

<materials>


  <material name="ZnWO4">
    <D type="density" unit="g/cm3" value="7.87" />
    <composite n="1" ref="Zn" />
    <composite n="1" ref="W" />
    <composite n="4" ref="O" />
  </material>


  <material name="HeavyLiquid">
    <D type="density" unit="g/cm3" value="2.8" />
    <fraction n="0.26" ref="Water" />
    <fraction n="0.56" ref="W" />
    <fraction n="0.02" ref="Na" />
    <fraction n="0.16" ref="O" />
  </material>


  <material name="WLSFiber">
    <D type="density" unit="g/cm3" value="1.05" />
    <composite n="8" ref="C" />
    <composite n="8" ref="H" />
  </material>


  <material name="PMMA" state="solid">
    <D value="1.19" unit="g/cm3"/>
    <composite n="5" ref="C" />
    <composite n="2" ref="O" />
    <composite n="8" ref="H" />
  </material>

  <!--Outer cladding material-->
  <material name="FP" state="solid">
    <D value="1.43" unit="g/cm3"/>
    <composite n="6" ref="C" />
    <composite n="7" ref="H" />
    <composite n="3" ref="F" />
    <composite n="2" ref="O" />
  </material>

  <!--Note: following material are defined by averaging grains, medium and fibers in 7mm pitch size
  Fiber structure: WLS fiber r = 0.5 mm, with 0.02 mm thick PMMA cladding -->

  <material name="MixGrains">
    <D type="density" unit="g/cm3" value="5.6395" />
    <fraction n="0.789857" ref="ZnWO4" />
    <fraction n="0.206890" ref="HeavyLiquid" />
    <fraction n="0.002979" ref="WLSFiber" />
    <fraction n="0.000274" ref="PMMA" />
    <property name="RINDEX" ref="RI_MixGrains_Default"/>
    <property name="ABSLENGTH" ref="AbsLen_MixGrains_Default"/>
    <property name="SCINTILLATIONCOMPONENT1" ref="ScintFast_MixGrains_Default"/>
    <constant name="SCINTILLATIONYIELD" value="10/MeV"/>
    <constant name="SCINTILLATIONTIMECONSTANT1" value="5.0*ns"/>
    <constant name="RESOLUTIONSCALE" value="1.0"/>
  </material>

  <material name="AirMixGrains">
    <D type="density" unit="g/cm3" value="4.4733" />
    <fraction n="0.995787" ref="ZnWO4" />
    <fraction n="0.000112" ref="Air" />
    <fraction n="0.003756" ref="WLSFiber" />
    <fraction n="0.000346" ref="PMMA" />
  </material>

  <material name="WaterMixGrains">
    <D type="density" unit="g/cm3" value="4.8895" />
    <fraction n="0.911024" ref="ZnWO4" />
    <fraction n="0.085224" ref="Water" />
    <fraction n="0.003436" ref="WLSFiber" />
    <fraction n="0.000316" ref="PMMA" />
  </material>


  <material name="CarbonFiber" state="solid">
    <MEE unit="eV" value="70.7270877537631"/>
    <D unit="g/cm3" value="1.46666666666667"/>
    <fraction n="0.794091986922138" ref="C"/>
    <fraction n="0.058408571165309" ref="H"/>
    <fraction n="0.147499441912553" ref="O"/>
  </material>

</materials>

