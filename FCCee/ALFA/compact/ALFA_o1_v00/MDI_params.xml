    <constant name="CollimatorInFrontOfQD0_dr" value="16*mm"/>

    <constant name="LumiCal_max_z" value="1186.5*mm" />
    <constant name="LumiCal_min_z" value="1074*mm"/>

    <constant name="CompSol_min_z" value="1230*mm"/>

  </define>

</lccdd>
