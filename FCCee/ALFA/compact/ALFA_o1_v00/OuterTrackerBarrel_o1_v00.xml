                <components name="OTBarFlex" r="OTBar_Stave_thickness + OTBar_Support_Foam_thickness + OTBar_Cooling_Plate_thickness + OTBar_Sensitive_thickness + OTBar_sens_Copper_thickness + OTBar_HDI_thickness" offset="0." length="OTBar_half_length">
                    <component thickness="OTBar_Flex_Kapton_thickness"    width="OTBar_Flex_width" r="0. + OTBar_Flex_Epoxy_thickness + OTBar_Flex_Aluminium_thickness + OTBar_Flex_Coverlay_thickness" material="Kapton" vis="OTBarFlexVis"/>
                    <component thickness="OTBar_Flex_Coverlay_thickness"    width="OTBar_Flex_width" r="0. + OTBar_Flex_Epoxy_thickness + OTBar_Flex_Aluminium_thickness" material="Coverlay" vis="OTBarFlexVis"/>
                    <component thickness="OTBar_Flex_Aluminium_thickness" width="OTBar_Flex_width" r="0. + OTBar_Flex_Epoxy_thickness" material="Aluminum" vis="OTBarFlexVis"/>
                    <component thickness="OTBar_Flex_Epoxy_thickness"      width="OTBar_Flex_width" r="0." material="Epoxy" vis="OTBarFlexVis"/>
                </components>


            </stave>

