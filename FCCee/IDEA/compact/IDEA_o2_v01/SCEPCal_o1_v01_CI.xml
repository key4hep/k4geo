    <vis name="tlbarrelAssemblyThetaVis"   alpha="0.1" r="0."  g="0."  b="1."  showDaughters="true"  visible="false"/>

    <vis name="tlendcapAssemblyGlobalVis"  alpha="0.1" r="1."  g="0."  b="0."  showDaughters="true"  visible="false"/>
    <vis name="tlendcapAssemblyPhiVis"     alpha="0.1" r="0."  g="1."  b="0."  showDaughters="true"  visible="false"/>
    <vis name="tlendcapAssemblyThetaVis"   alpha="0.1" r="0."  g="0."  b="1."  showDaughters="true"  visible="false"/>

    <vis name="scepcalAssemblyGlobalVis" alpha="0.5" r="0.1"  g="0.2"  b="0.1"  showDaughters="true"  visible="false"/>
  </display>

