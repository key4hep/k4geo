              crystalTdepth="scepcal_timing_xtal_depth"
              crystalTlength="scepcal_timing_xtal_length"

              beampipe_opening="scepcal_beampipe_opening"
              timing_gap="scepcal_timinglayer_gap"
              
              phiSegments="scepcal_phi_segments"
              projectiveOffsetR="scepcal_projective_offset_r"
              
              useOpticalSurfaces="false"
              />

      <tlbarrel  system="DetID_Timing_Barrel" construct="false"/>
      <tlendcap  system="DetID_Timing_Endcap" construct="false"/>

      <crystalT  material="LYSO"          vis="crystalTVis"/>

      <tlbarrelAssemblyGlobalVis  vis="tlbarrelAssemblyGlobalVis"/>
      <tlbarrelAssemblyPhiVis     vis="tlbarrelAssemblyPhiVis"/>
      <tlbarrelAssemblyThetaVis   vis="tlbarrelAssemblyThetaVis"/>

      <tlendcapAssemblyGlobalVis  vis="tlendcapAssemblyGlobalVis"/>
      <tlendcapAssemblyPhiVis     vis="tlendcapAssemblyPhiVis"/>
      <tlendcapAssemblyThetaVis   vis="tlendcapAssemblyThetaVis"/>

      <scepcalAssemblyGlobalVis vis="scepcalAssemblyGlobalVis"/>
    </detector>

