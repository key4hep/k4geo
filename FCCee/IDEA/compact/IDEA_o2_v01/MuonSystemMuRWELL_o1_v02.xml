<?xml version="1.0" encoding="UTF-8"?>
<lccdd>

  <info name="MuonSystem"
	title="IDEA muon system: 4-layer layout with 500 mm iron yoke for FCC-ee"
	author="Mahmoud Althakeel, mahmoud.althakeel@cern.ch"
	url="no"
	status="development"
	version="o1_v02">
    <comment>
      Version o1_v02: 4 active layers (3 yokes), 500 mm iron yoke thickness.
      Increases sensitive decay-length coverage to ~6 m relative to o1_v01
      (3 layers, 300 mm yoke).  Factory: muonSystem_o1_v01.
    </comment>
  </info>

  <define>
     <!---                            Muon System Parameters                       -->
     <!-- %%%%%%                      microRWELL chamber different layers thicknesses                %%%%%% -->
       <constant name = "G10_FR4Thick"                          value = "1.6*mm"/>
       <constant name = "CuThick"                               value = "0.035*mm"/>
       <constant name = "GasLayerThick"                         value = "6*mm"/>
       <constant name = "Cu2Thick"                              value = "0.005*mm"/>
       <constant name = "KaptonThick"                           value = "0.05*mm"/>
       <constant name = "CarbonFiberThick"                      value = "0.0001*mm"/>
       <constant name = "CarbonFiber2Thick"                     value = "0.1*mm"/>
       <constant name = "SiThick"                               value = "1.6*mm"/>
       <constant name = "mRWELLTotalThickness"                  value = "G10_FR4Thick+CuThick+GasLayerThick+Cu2Thick+KaptonThick+CarbonFiberThick+CuThick+CarbonFiber2Thick+CuThick+SiThick"/> <!-- This sequence is the current order of mRWELL (total 10 slices) -->

       <constant name = "mRWELLYLength"                         value = "250*mm"/>
       <constant name = "mRWELLZLength"                         value = "250*mm"/>

       <constant name = "overlappingY"                          value = "5*mm"/> <!-- overlap of two neighbouring mRWELL chambers in Y: they cover the same 5 mm, so there is no dead area between them -->
       <constant name = "overlappingZ"                          value = "5*mm"/> <!-- overlap of two neighbouring mRWELL chambers in Z: they cover the same 5 mm, so there is no dead area between them -->
       <constant name = "clearance"                             value = "1*mm"/> <!-- it's a small distance to be used to avoid overlapping between the different volumes ~ 1 mm -->
     <!-- %%%%%%                      Iron yoke thickness (500 mm)          %%%%%% -->
      <constant name = "YokeThickness"                          value = "500*mm"/>
      <!-- %%%%%%                      Readout description                  %%%%%% -->
      <constant name = "MuonSystemReadoutID"            type="string"  value = "system:5,type:-2,layer:2,chamber:13,slice:1,y:-10,z:-10"/>  <!-- The bit field is divided into 2^5 systems(IDEA sub-detectors), 2^2 types(0 = Barrel Muon System, +1 = positive endcap, and -1 = negative endcap), 2^2 layers(number of layers in barrel for example) ,2^13 chambers(the number of muRWELL chambers in every layer), 2^1 slice(number of sensitive layers inside every chamber), and 2^10 y&z strips in every sensitive layer-->
  </define>

  <readouts>
    <readout name="MuonSystemCollection">
     <segmentation type="CartesianGridYZ" grid_size_y="1.2*mm" grid_size_z="1.2*mm"/>   <!-- Depending on strip pitch 1.4 mm  -->
     <id>${MuonSystemReadoutID}</id>
  </readout>
  </readouts>

  <detectors>
    <!-- mRWELL envelope -->
    <detector name="Muon-System" type="muonSystem_o1_v01" id="DetID_muonSystem" readout="MuonSystemCollection">
      <dimensions x="mRWELLTotalThickness/2.0" y="mRWELLYLength" z="mRWELLZLength" x_offset="0*mm" y_offset="0*mm" z_offset="0*mm" material="Air"/>

      <!-- Specify the detector parameters and the overlap. If you want to exclude a component, e.g. the endcap, set numDetectorLayers=0 in the Endcap entry. The radius is put in the middle, so it is neither the inner nor the outer one -->
      <generalParameters numSides="numberOfSides" overlapY="overlappingY" overlapZ="overlappingZ" clearance="clearance"/>
      <Barrel numDetectorLayers ="4"  rmin="BarrelFirstLayerRadius" length="BarrelLength" numYokes="3" yoke_Thickness="YokeThickness" yoke_Material="G4_Fe"/>
      <Endcap numDetectorLayers="4"  rmin="EndcapLayersInnerRadius"  z_offset="EndcapFirstLayerZOffset" numYokes="3" yoke_Thickness="YokeThickness" yoke_Material="G4_Fe" />

      <!-- mRWELL chamber -->
      <!-- note: all thicknesses are half-lengths -->
      <slice x="G10_FR4Thick/2.0" material="G10_FR4" vis="G10_FR4_vis" />
      <slice x="CuThick/2.0" material="G4_Cu" vis="Cu_vis" />
      <slice x="GasLayerThick/2.0" material="ARCO2CF4" sensitive="true" vis="Sensitive_vis" />
      <slice x="Cu2Thick/2.0" material="G4_Cu" vis="Cu_vis" />
      <slice x="KaptonThick/2.0" material="Kapton" vis="Kapton_vis" />
      <slice x="CarbonFiberThick/2.0" material="CarbonFiber" vis="CarbonFiber_vis" />
      <slice x="CuThick/2.0" material="G4_Cu" vis="Cu_vis" />
      <slice x="CarbonFiber2Thick/2.0" material="CarbonFiber" vis="CarbonFiber_vis" />
      <slice x="CuThick/2.0" material="G4_Cu" vis="Cu_vis" />
      <slice x="SiThick/2.0" material="G4_Si" vis="Si_vis" />
    </detector>
  </detectors>

  <plugins>
    <plugin name="DD4hep_GenericSurfaceInstallerPlugin"> <!-- Plugin needed for the surfaces-->
      <argument value="Muon-System" />
      <argument value="dimension=2" />
      <argument value="u_y=1." />
      <argument value="v_z=1." />
      <argument value="n_x=1." />
    </plugin>
  </plugins>

</lccdd>
