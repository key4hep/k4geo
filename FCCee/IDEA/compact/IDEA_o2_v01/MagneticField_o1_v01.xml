<?xml version="1.0" encoding="UTF-8"?>
<!-- IDEA magnetic field (IDEA_o2_v01 and IDEA_o1_v04), generated by make_idea_field.py:
     uniform SolenoidField in the coil, one Bz in the whole barrel muon system, one Br in each
     whole endcap muon system (8 ConstantField wedges, one per octagon side, field perpendicular
     to the side). Values: FEM field map average in the muon-system iron (3 T map), written per
     SolenoidField (valid for 2 T and 3 T). Include after the muon system (uses YokeThickness). -->
<lccdd>
  <define>
    <constant name="MuonField_layer" value="120.31*mm"/>  <!-- one muon detector layer (muonSystemMuRWELL_o1_v01.cpp) -->
    <constant name="MuonField_rmax" value="BarrelFirstLayerRadius + 3*MuonField_layer + 2*YokeThickness"/>  <!-- muon system outer radius -->
    <constant name="MuonField_dz" value="(3*MuonField_layer + 2*YokeThickness)/2 - 0.1*mm"/>  <!-- endcap half thickness -->
    <constant name="MuonField_z" value="EndcapFirstLayerZOffset + MuonField_dz + 0.1*mm"/>  <!-- endcap centre z -->
    <constant name="MuonField_Bz" value="-0.5401*SolenoidField"/>  <!-- barrel muon system Bz -->
    <constant name="MuonField_Br" value="0.4686*SolenoidField"/>  <!-- endcap muon system Br, outwards at +z -->
  </define>
  <fields>
    <field name="GlobalSolenoid" type="solenoid" inner_field="SolenoidField" outer_field="0*tesla"
           inner_radius="Solenoid_Coil_radius" outer_radius="Solenoid_Coil_radius"
           zmin="-1.2*Solenoid_Coil_half_length" zmax="1.2*Solenoid_Coil_half_length"/>
    <!-- barrel muon system: octagon rotated like the muon system -->
    <field name="MuonField_barrel" type="ConstantField" field="magnetic"><strength x="0" y="0" z="MuonField_Bz"/>
      <shape type="PolyhedraRegular" numsides="numberOfSides" rmin="BarrelFirstLayerRadius" rmax="MuonField_rmax"
             dz="BarrelLength - 0.2*mm"><rotation x="0" y="0" z="180*deg/numberOfSides"/></shape></field>
    <!-- +z endcap muon system: 8 wedges, one per octagon side -->
    <field name="MuonField_zplus0" type="ConstantField" field="magnetic"><strength x="MuonField_Br*cos(0*deg)" y="MuonField_Br*sin(0*deg)" z="0"/>
      <shape type="Polyhedra" numsides="1" startphi="-22.5*deg" deltaphi="44.999*deg"><plane z="-MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><plane z="MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><position x="0" y="0" z="MuonField_z"/></shape></field>
    <field name="MuonField_zplus1" type="ConstantField" field="magnetic"><strength x="MuonField_Br*cos(45*deg)" y="MuonField_Br*sin(45*deg)" z="0"/>
      <shape type="Polyhedra" numsides="1" startphi="22.5*deg" deltaphi="44.999*deg"><plane z="-MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><plane z="MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><position x="0" y="0" z="MuonField_z"/></shape></field>
    <field name="MuonField_zplus2" type="ConstantField" field="magnetic"><strength x="MuonField_Br*cos(90*deg)" y="MuonField_Br*sin(90*deg)" z="0"/>
      <shape type="Polyhedra" numsides="1" startphi="67.5*deg" deltaphi="44.999*deg"><plane z="-MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><plane z="MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><position x="0" y="0" z="MuonField_z"/></shape></field>
    <field name="MuonField_zplus3" type="ConstantField" field="magnetic"><strength x="MuonField_Br*cos(135*deg)" y="MuonField_Br*sin(135*deg)" z="0"/>
      <shape type="Polyhedra" numsides="1" startphi="112.5*deg" deltaphi="44.999*deg"><plane z="-MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><plane z="MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><position x="0" y="0" z="MuonField_z"/></shape></field>
    <field name="MuonField_zplus4" type="ConstantField" field="magnetic"><strength x="MuonField_Br*cos(180*deg)" y="MuonField_Br*sin(180*deg)" z="0"/>
      <shape type="Polyhedra" numsides="1" startphi="157.5*deg" deltaphi="44.999*deg"><plane z="-MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><plane z="MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><position x="0" y="0" z="MuonField_z"/></shape></field>
    <field name="MuonField_zplus5" type="ConstantField" field="magnetic"><strength x="MuonField_Br*cos(225*deg)" y="MuonField_Br*sin(225*deg)" z="0"/>
      <shape type="Polyhedra" numsides="1" startphi="202.5*deg" deltaphi="44.999*deg"><plane z="-MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><plane z="MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><position x="0" y="0" z="MuonField_z"/></shape></field>
    <field name="MuonField_zplus6" type="ConstantField" field="magnetic"><strength x="MuonField_Br*cos(270*deg)" y="MuonField_Br*sin(270*deg)" z="0"/>
      <shape type="Polyhedra" numsides="1" startphi="247.5*deg" deltaphi="44.999*deg"><plane z="-MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><plane z="MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><position x="0" y="0" z="MuonField_z"/></shape></field>
    <field name="MuonField_zplus7" type="ConstantField" field="magnetic"><strength x="MuonField_Br*cos(315*deg)" y="MuonField_Br*sin(315*deg)" z="0"/>
      <shape type="Polyhedra" numsides="1" startphi="292.5*deg" deltaphi="44.999*deg"><plane z="-MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><plane z="MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><position x="0" y="0" z="MuonField_z"/></shape></field>
    <!-- -z endcap muon system: same, Br inwards -->
    <field name="MuonField_zminus0" type="ConstantField" field="magnetic"><strength x="-MuonField_Br*cos(0*deg)" y="-MuonField_Br*sin(0*deg)" z="0"/>
      <shape type="Polyhedra" numsides="1" startphi="-22.5*deg" deltaphi="44.999*deg"><plane z="-MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><plane z="MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><position x="0" y="0" z="-MuonField_z"/></shape></field>
    <field name="MuonField_zminus1" type="ConstantField" field="magnetic"><strength x="-MuonField_Br*cos(45*deg)" y="-MuonField_Br*sin(45*deg)" z="0"/>
      <shape type="Polyhedra" numsides="1" startphi="22.5*deg" deltaphi="44.999*deg"><plane z="-MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><plane z="MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><position x="0" y="0" z="-MuonField_z"/></shape></field>
    <field name="MuonField_zminus2" type="ConstantField" field="magnetic"><strength x="-MuonField_Br*cos(90*deg)" y="-MuonField_Br*sin(90*deg)" z="0"/>
      <shape type="Polyhedra" numsides="1" startphi="67.5*deg" deltaphi="44.999*deg"><plane z="-MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><plane z="MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><position x="0" y="0" z="-MuonField_z"/></shape></field>
    <field name="MuonField_zminus3" type="ConstantField" field="magnetic"><strength x="-MuonField_Br*cos(135*deg)" y="-MuonField_Br*sin(135*deg)" z="0"/>
      <shape type="Polyhedra" numsides="1" startphi="112.5*deg" deltaphi="44.999*deg"><plane z="-MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><plane z="MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><position x="0" y="0" z="-MuonField_z"/></shape></field>
    <field name="MuonField_zminus4" type="ConstantField" field="magnetic"><strength x="-MuonField_Br*cos(180*deg)" y="-MuonField_Br*sin(180*deg)" z="0"/>
      <shape type="Polyhedra" numsides="1" startphi="157.5*deg" deltaphi="44.999*deg"><plane z="-MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><plane z="MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><position x="0" y="0" z="-MuonField_z"/></shape></field>
    <field name="MuonField_zminus5" type="ConstantField" field="magnetic"><strength x="-MuonField_Br*cos(225*deg)" y="-MuonField_Br*sin(225*deg)" z="0"/>
      <shape type="Polyhedra" numsides="1" startphi="202.5*deg" deltaphi="44.999*deg"><plane z="-MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><plane z="MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><position x="0" y="0" z="-MuonField_z"/></shape></field>
    <field name="MuonField_zminus6" type="ConstantField" field="magnetic"><strength x="-MuonField_Br*cos(270*deg)" y="-MuonField_Br*sin(270*deg)" z="0"/>
      <shape type="Polyhedra" numsides="1" startphi="247.5*deg" deltaphi="44.999*deg"><plane z="-MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><plane z="MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><position x="0" y="0" z="-MuonField_z"/></shape></field>
    <field name="MuonField_zminus7" type="ConstantField" field="magnetic"><strength x="-MuonField_Br*cos(315*deg)" y="-MuonField_Br*sin(315*deg)" z="0"/>
      <shape type="Polyhedra" numsides="1" startphi="292.5*deg" deltaphi="44.999*deg"><plane z="-MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><plane z="MuonField_dz" rmin="EndcapLayersInnerRadius" rmax="MuonField_rmax"/><position x="0" y="0" z="-MuonField_z"/></shape></field>
  </fields>
</lccdd>
