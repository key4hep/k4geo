<lccdd>
    <comment> FCC-SEED inner vertex detector with curved, overlapping sensors. Implemented by Armin Ilg (UZH). </comment>

    <define>
        <comment>FCC-SEED inner vertex sensor properties</comment>
        <constant name="VTXIB_SEED_sensor_phi_sensitive" value="20.0*mm"/>
        <constant name="VTXIB_SEED_sensor_phi_periphery" value="3.0*mm"/>
        <constant name="VTXIB_SEED_sensor_phi" value="VTXIB_SEED_sensor_phi_sensitive+VTXIB_SEED_sensor_phi_periphery"/>
        <constant name="VTXIB_SEED_sensor_z_sensitive" value="29.9*mm"/>
        <constant name="VTXIB_SEED_sensor_z_periphery" value="0.100*mm"/>
        <constant name="VTXIB_SEED_sensor_z" value="VTXIB_SEED_sensor_z_sensitive+VTXIB_SEED_sensor_z_periphery"/>

        <constant name="VTXIB_SEED_insensitive_thickness_below"   value="40e-03*mm"/> <comment> Assume 40 µm of insensitive sensor thickness </comment>
        <constant name="VTXIB_SEED_sensitive_thickness"           value="10e-03*mm"/> <comment> Assume 10 µm of sensitive sensor thickness, reflecting epi-layer thickness in TPSCo 65 nm process </comment>
        <constant name="VTXIB_SEED_insensitive_thickness_above"   value="0e-03*mm"/> <comment> Assume no metal layer for powering </comment>
        <constant name="VTXIB_SEED_total_sensor_thickness"        value="VTXIB_SEED_insensitive_thickness_below+VTXIB_SEED_sensitive_thickness+VTXIB_SEED_insensitive_thickness_above"/>

        <comment> Representation of curved sensitive elements by number of trapezoids with flat surface. The more, the more round the sensors are. Multiplies the number of surfaces by this number, careful!
            Use '4' to be able to use conformal tracking. Use '1' to have perfect cylindrical surfaces. </comment>
        <constant name="VTXIB_curved_nsegments" value="16"/> 
        <constant name="VTXIB_curved_tolerance_r" value="0.100*mm"/> <!-- Needed for curved inner vertex as otherwise overlaps would be detected. -->

        <comment> FCC-SEED global crucial layer properties innermost positions </comment>
        <constant name="VTXIB_SEED_r1" value="VTXIB_r_min_layer"/>
        <constant name="VTXIB_SEED_r2" value="24.0*mm"/>
        <constant name="VTXIB_SEED_r3" value="36.0*mm"/>
        <constant name="VTXIB_SEED_r4" value="48.0*mm"/>
        <constant name="VTXIB_SEED_r5" value="60.0*mm"/>

        <constant name="VTXIB_SEED_nModules1" value="6"/>
        <constant name="VTXIB_SEED_nModules2" value="8"/>
        <constant name="VTXIB_SEED_nModules3" value="8"/>
        <constant name="VTXIB_SEED_nModules4" value="8"/>
        <constant name="VTXIB_SEED_nModules5" value="8"/>

        <constant name="VTXIB_SEED_staves1" value="4"/>
        <constant name="VTXIB_SEED_staves2" value="8"/>
        <constant name="VTXIB_SEED_staves3" value="12"/>
        <constant name="VTXIB_SEED_staves4" value="16"/>
        <constant name="VTXIB_SEED_staves5" value="20"/>

        <!-- For double-layer layout -->
        <!-- <constant name="VTXIB_SEED_staves1" value="8"/>
        <constant name="VTXIB_SEED_staves2" value="16"/>
        <constant name="VTXIB_SEED_staves3" value="24"/>
        <constant name="VTXIB_SEED_staves4" value="32"/>
        <constant name="VTXIB_SEED_staves5" value="40"/> -->

        <constant name="VTXIB_SEED_half_length1" value="VTXIB_SEED_nModules1*VTXIB_SEED_sensor_z/2."/>
        <constant name="VTXIB_SEED_half_length2" value="VTXIB_SEED_nModules2*VTXIB_SEED_sensor_z/2."/>
        <constant name="VTXIB_SEED_half_length3" value="VTXIB_SEED_nModules3*VTXIB_SEED_sensor_z/2."/>
        <constant name="VTXIB_SEED_half_length4" value="VTXIB_SEED_nModules4*VTXIB_SEED_sensor_z/2."/>
        <constant name="VTXIB_SEED_half_length5" value="VTXIB_SEED_nModules5*VTXIB_SEED_sensor_z/2."/>

        <constant name="VTXIB_SEED_zoffset1" value="0.0*mm"/> 
        <constant name="VTXIB_SEED_zoffset2" value="-0.5*mm"/> <comment> To make sure no gap at theta=90 degrees exists </comment>
        <constant name="VTXIB_SEED_zoffset3" value="+0.5*mm"/>
        <constant name="VTXIB_SEED_zoffset4" value="-0.5*mm"/>
        <constant name="VTXIB_SEED_zoffset5" value="+0.5*mm"/>

        <comment> Longeron-like support between two curved sensors ('betweenSensors') and between layers ('betweenLayers') </comment>
        <constant name="Support_longeron_betweenSensors_tolerance" value="VTXIB_curved_tolerance_r+0.1*mm"/>
        <constant name="Support_longeron_betweenSensors_thickness" value="0.5*mm-Support_longeron_betweenSensors_tolerance"/>

        <comment> Curvature of the curved sensors, not the same as the closest radial position! </comment>
        <constant name="VTXIB_SEED_curvature1" value="VTXIB_SEED_r1"/>
        <constant name="VTXIB_SEED_curvature2" value="VTXIB_SEED_r2"/>
        <constant name="VTXIB_SEED_curvature3" value="VTXIB_SEED_r3"/>
        <constant name="VTXIB_SEED_curvature4" value="VTXIB_SEED_r4"/>
        <constant name="VTXIB_SEED_curvature5" value="VTXIB_SEED_r5"/>

        <!-- <constant name="VTXIB_SEED_curvature1" value="VTXIB_SEED_r1+VTXIB_SEED_total_sensor_thickness+Support_longeron_betweenSensors_thickness+5.*VTXIB_curved_tolerance_r"/>
        <constant name="VTXIB_SEED_curvature2" value="VTXIB_SEED_r2+VTXIB_SEED_total_sensor_thickness+Support_longeron_betweenSensors_thickness+5.*VTXIB_curved_tolerance_r"/>
        <constant name="VTXIB_SEED_curvature3" value="VTXIB_SEED_r3+VTXIB_SEED_total_sensor_thickness+Support_longeron_betweenSensors_thickness+5.*VTXIB_curved_tolerance_r"/>
        <constant name="VTXIB_SEED_curvature4" value="VTXIB_SEED_r4+VTXIB_SEED_total_sensor_thickness+Support_longeron_betweenSensors_thickness+5.*VTXIB_curved_tolerance_r"/>
        <constant name="VTXIB_SEED_curvature5" value="VTXIB_SEED_r5+VTXIB_SEED_total_sensor_thickness+Support_longeron_betweenSensors_thickness+5.*VTXIB_curved_tolerance_r"/>
            -->
        <constant name="VTXIB_SEED_sensor_offset1" value="(VTXIB_SEED_total_sensor_thickness + VTXIB_curved_tolerance_r + Support_longeron_betweenSensors_thickness+Support_longeron_betweenSensors_tolerance)/sin(4./VTXIB_SEED_staves1*90*deg)"/>
        <constant name="VTXIB_SEED_sensor_offset2" value="(VTXIB_SEED_total_sensor_thickness + VTXIB_curved_tolerance_r + Support_longeron_betweenSensors_thickness+Support_longeron_betweenSensors_tolerance)/sin(4./VTXIB_SEED_staves2*90*deg)"/>
        <constant name="VTXIB_SEED_sensor_offset3" value="(VTXIB_SEED_total_sensor_thickness + VTXIB_curved_tolerance_r + Support_longeron_betweenSensors_thickness+Support_longeron_betweenSensors_tolerance)/sin(4./VTXIB_SEED_staves3*90*deg)"/>
        <constant name="VTXIB_SEED_sensor_offset4" value="(VTXIB_SEED_total_sensor_thickness + VTXIB_curved_tolerance_r + Support_longeron_betweenSensors_thickness+Support_longeron_betweenSensors_tolerance)/sin(4./VTXIB_SEED_staves4*90*deg)"/>
        <constant name="VTXIB_SEED_sensor_offset5" value="(VTXIB_SEED_total_sensor_thickness + VTXIB_curved_tolerance_r + Support_longeron_betweenSensors_thickness+Support_longeron_betweenSensors_tolerance)/sin(4./VTXIB_SEED_staves5*90*deg)"/>

        <constant name="VTXIB_SEED_phi_offset"  value="VTXIB_SEED_sensor_phi_sensitive/2./VTXIB_SEED_curvature1*360*deg"/> <comment> To have first sensor start at phi=0 so along the x-axis </comment>
        <constant name="VTXIB_SEED_phi_offset1" value="VTXIB_SEED_phi_offset+VTXIB_SEED_staves1/VTXIB_SEED_staves1*90*deg/2."/>
        <constant name="VTXIB_SEED_phi_offset2" value="VTXIB_SEED_phi_offset+VTXIB_SEED_staves1/VTXIB_SEED_staves2*90*deg/2.+VTXIB_SEED_staves1/VTXIB_SEED_staves2*45*deg"/>
        <constant name="VTXIB_SEED_phi_offset3" value="VTXIB_SEED_phi_offset+VTXIB_SEED_staves1/VTXIB_SEED_staves3*90*deg/2.+VTXIB_SEED_staves1/VTXIB_SEED_staves3*45*deg"/>
        <constant name="VTXIB_SEED_phi_offset4" value="VTXIB_SEED_phi_offset+VTXIB_SEED_staves1/VTXIB_SEED_staves4*90*deg/2.+VTXIB_SEED_staves1/VTXIB_SEED_staves4*45*deg"/>
        <constant name="VTXIB_SEED_phi_offset5" value="VTXIB_SEED_phi_offset+VTXIB_SEED_staves1/VTXIB_SEED_staves5*90*deg/2.+VTXIB_SEED_staves1/VTXIB_SEED_staves5*45*deg"/>

        <comment> Flex on top of sensor periphery </comment>
        <constant name="Flex_Kapton_thickness"  value="0.200*mm"/>
        <constant name="Flex_Al_thickness"      value="0.050*mm"/>
        <constant name="Flex_total_thickness"   value="Flex_Kapton_thickness + Flex_Al_thickness"/>

        <constant name="Flex_curved_tolerance_r" value="0.7*mm"/> <comment> To avoid overlaps </comment>

        <constant name="Flex_width"  value="3.6*mm"/>

        <comment> Have the flexes and in-layer longerons at the correct phi position (need to correct sensor offset with 'VTXIB_SEED_sensor_offset') </comment>
        <constant name="Flex_offset_phi1" value= "(VTXIB_SEED_sensor_phi+Flex_width/2.)/VTXIB_SEED_curvature1*rad"/>
        <constant name="Flex_offset_phi2" value= "(VTXIB_SEED_sensor_phi+Flex_width/2.)/VTXIB_SEED_curvature2*rad"/>
        <constant name="Flex_offset_phi3" value= "(VTXIB_SEED_sensor_phi+Flex_width/2.)/VTXIB_SEED_curvature3*rad"/>
        <constant name="Flex_offset_phi4" value= "(VTXIB_SEED_sensor_phi+Flex_width/2.)/VTXIB_SEED_curvature4*rad"/>
        <constant name="Flex_offset_phi5" value= "(VTXIB_SEED_sensor_phi+Flex_width/2.)/VTXIB_SEED_curvature5*rad"/>

        <comment> End-of-stave hybrid holding e.g. opto-electronics and power converters </comment>
        <constant name="VTXIB_hybrid_thickness" value="0.250*mm"/>
        <constant name="VTXIB_hybrid_length"    value="12.0*mm"/>
        <constant name="VTXIB_hybrid_width"     value="2.*Flex_width"/>
        <constant name="VTXIB_hybrid_opto_thickness" value="0.100*mm"/> <comment> Assume 100 µm of silicon-equivalent opto-electronics thickness </comment>
        <constant name="VTXIB_hybrid_opto_width" value="5.0*mm"/> <comment> Assume 5x5 mm^2 size of opto-electronics ASIC </comment>

        <comment> Further longeron properties </comment>
        <constant name="Support_longeron_betweenSensors_offset_r1" value="VTXIB_SEED_r1-VTXIB_SEED_curvature1-VTXIB_SEED_total_sensor_thickness-Support_longeron_betweenSensors_thickness"/>
        <constant name="Support_longeron_betweenSensors_offset_r2" value="VTXIB_SEED_r2-VTXIB_SEED_curvature2-VTXIB_SEED_total_sensor_thickness-Support_longeron_betweenSensors_thickness"/>
        <constant name="Support_longeron_betweenSensors_offset_r3" value="VTXIB_SEED_r3-VTXIB_SEED_curvature3-VTXIB_SEED_total_sensor_thickness-Support_longeron_betweenSensors_thickness"/>
        <constant name="Support_longeron_betweenSensors_offset_r4" value="VTXIB_SEED_r4-VTXIB_SEED_curvature4-VTXIB_SEED_total_sensor_thickness-Support_longeron_betweenSensors_thickness"/>
        <constant name="Support_longeron_betweenSensors_offset_r5" value="VTXIB_SEED_r5-VTXIB_SEED_curvature5-VTXIB_SEED_total_sensor_thickness-Support_longeron_betweenSensors_thickness"/>

        <constant name="Support_longeron_betweenSensors_width" value="Flex_width+VTXIB_SEED_sensor_phi_periphery"/> <comment> Make the support just as wide as flex+sensor periphery </comment>

        <constant name="Support_longeron_betweenSensors_phi1_1" value= "(VTXIB_SEED_sensor_phi_sensitive+1.*Support_longeron_betweenSensors_width/6.)/VTXIB_SEED_curvature1*rad"/> <comment> Split into three volumes for first layer to avoid overlaps </comment>
        <constant name="Support_longeron_betweenSensors_phi1_2" value= "(VTXIB_SEED_sensor_phi_sensitive+3.*Support_longeron_betweenSensors_width/6.)/VTXIB_SEED_curvature1*rad"/>
        <constant name="Support_longeron_betweenSensors_phi1_3" value= "(VTXIB_SEED_sensor_phi_sensitive+5.*Support_longeron_betweenSensors_width/6.)/VTXIB_SEED_curvature1*rad"/>
        <constant name="Support_longeron_betweenSensors_phi2" value= "(VTXIB_SEED_sensor_phi_sensitive+Support_longeron_betweenSensors_width/2.)/VTXIB_SEED_curvature2*rad"/>
        <constant name="Support_longeron_betweenSensors_phi3" value= "(VTXIB_SEED_sensor_phi_sensitive+Support_longeron_betweenSensors_width/2.)/VTXIB_SEED_curvature3*rad"/>
        <constant name="Support_longeron_betweenSensors_phi4" value= "(VTXIB_SEED_sensor_phi_sensitive+Support_longeron_betweenSensors_width/2.)/VTXIB_SEED_curvature4*rad"/>
        <constant name="Support_longeron_betweenSensors_phi5" value= "(VTXIB_SEED_sensor_phi_sensitive+Support_longeron_betweenSensors_width/2.)/VTXIB_SEED_curvature5*rad"/>


        <constant name="Support_longeron_betweenLayers_offset_r1" value="Flex_total_thickness"/>
        <constant name="Support_longeron_betweenLayers_offset_r2" value="Flex_total_thickness"/>
        <constant name="Support_longeron_betweenLayers_offset_r3" value="Flex_total_thickness"/>
        <constant name="Support_longeron_betweenLayers_offset_r4" value="Flex_total_thickness"/>
        <constant name="Support_longeron_betweenLayers_offset_r5" value="Flex_total_thickness"/>

        <constant name="Support_longeron_betweenLayers_tolerance" value="1.4*mm"/> <comment> To avoid overlaps, needed since support longerons don't point to the IP exactly </comment>
        <constant name="Support_longeron_betweenLayers_thickness1" value="VTXIB_SEED_r2 - VTXIB_SEED_curvature1 - 2.*VTXIB_SEED_total_sensor_thickness - Flex_total_thickness - Support_longeron_betweenLayers_offset_r1 - VTXIB_curved_tolerance_r - Support_longeron_betweenLayers_tolerance"/>
        <constant name="Support_longeron_betweenLayers_thickness2" value="VTXIB_SEED_r3 - VTXIB_SEED_curvature2 - 2.*VTXIB_SEED_total_sensor_thickness - Flex_total_thickness - Support_longeron_betweenLayers_offset_r2 - VTXIB_curved_tolerance_r - Support_longeron_betweenLayers_tolerance"/>
        <constant name="Support_longeron_betweenLayers_thickness3" value="VTXIB_SEED_r4 - VTXIB_SEED_curvature3 - 2.*VTXIB_SEED_total_sensor_thickness - Flex_total_thickness - Support_longeron_betweenLayers_offset_r3 - VTXIB_curved_tolerance_r - Support_longeron_betweenLayers_tolerance"/>
        <constant name="Support_longeron_betweenLayers_thickness4" value="VTXIB_SEED_r5 - VTXIB_SEED_curvature4 - 2.*VTXIB_SEED_total_sensor_thickness - Flex_total_thickness - Support_longeron_betweenLayers_offset_r4 - VTXIB_curved_tolerance_r - Support_longeron_betweenLayers_tolerance"/>

        <comment> Support rings between the FCC-SEED layers </comment>
        <constant name="Support_ring_length"    value="2.0*mm"/> <comment> Length in z direction </comment>

        <constant name="Support_ring_offset_r" value="VTXIB_SEED_total_sensor_thickness+Flex_total_thickness+VTXIB_curved_tolerance_r"/>

        <constant name="Support_ring_width1" value="(VTXIB_SEED_r1+Support_ring_offset_r)/VTXIB_SEED_staves1*2*pi*1.02"/> <comment> scaling to make the four ring pieces connect </comment>
        <constant name="Support_ring_width2" value="(VTXIB_SEED_r2+Support_ring_offset_r)/VTXIB_SEED_staves2*2*pi*1.00"/> <comment> scaling to make the four ring pieces connect </comment>
        <constant name="Support_ring_width3" value="(VTXIB_SEED_r3+Support_ring_offset_r)/VTXIB_SEED_staves3*2*pi*1.00"/> <comment> scaling to make the four ring pieces connect </comment>
        <constant name="Support_ring_width4" value="(VTXIB_SEED_r4+Support_ring_offset_r)/VTXIB_SEED_staves4*2*pi*1.00"/> <comment> scaling to make the four ring pieces connect </comment>


        <constant name="Support_ring_thickness1" value="Support_longeron_betweenLayers_thickness1-0.5*mm"/> <comment> A bit less thick in first layer to avoid overlap </comment>
        <constant name="Support_ring_thickness2" value="Support_longeron_betweenLayers_thickness2"/>
        <constant name="Support_ring_thickness3" value="Support_longeron_betweenLayers_thickness3"/>
        <constant name="Support_ring_thickness4" value="Support_longeron_betweenLayers_thickness4"/>

        <constant name="Support_ring_offset_phi1" value= "(VTXIB_SEED_sensor_phi+Flex_width-Support_ring_width1/2.)/VTXIB_SEED_curvature1*rad"/>
        <constant name="Support_ring_offset_phi2" value= "(VTXIB_SEED_sensor_phi+Flex_width-Support_ring_width2/2.)/VTXIB_SEED_curvature2*rad"/>
        <constant name="Support_ring_offset_phi3" value= "(VTXIB_SEED_sensor_phi+Flex_width-Support_ring_width3/2.)/VTXIB_SEED_curvature3*rad"/>
        <constant name="Support_ring_offset_phi4" value= "(VTXIB_SEED_sensor_phi+Flex_width-Support_ring_width4/2.)/VTXIB_SEED_curvature4*rad"/>

        <comment> Variables used for imported xmls </comment>
        <constant name="VTXIB_tube_r"                       value="VTXIB_SEED_curvature5+2.*VTXIB_SEED_total_sensor_thickness+Support_longeron_betweenSensors_thickness+Support_longeron_betweenSensors_tolerance+Flex_total_thickness+7.*VTXIB_curved_tolerance_r"/> 
        <constant name="VTXIB_Kapton_beampipe_halfLength"   value="VTXIB_SEED_half_length1"/>
        <constant name="VTXIB_tube_half_length"             value="VTXIB_SEED_half_length5"/>
    </define>

    <readouts> <comment>  Definition of the readout segmentation/definition </comment>
        <readout name="VertexBarrelCollection"> 
            <segmentation type="MultiSegmentation" key="layer">
                <segmentation name="VTXIBgrid" type="CartesianGridXY" key_min="0" key_max="4" grid_size_x="VTXIB_pitch_phi" grid_size_y="VTXIB_pitch_z"/>
            </segmentation>
            <id>${GlobalTrackerReadoutID},x:32:-16,y:-16</id>
        </readout>  
    </readouts>

    <!-- Inner vertex detector made of overlapping, curved sensors -->
    <detectors>
        <detector name="VertexBarrel" type="VertexBarrel_detailed_o1_v03" vis="VXDVis" id="DetID_VXD_Barrel" readout="VertexBarrelCollection"  region="VertexBarrelRegion">
            <envelope vis="VXDVis">
                <shape type="Assembly"/>
            </envelope>

            <type_flags type=" DetType_TRACKER + DetType_PIXEL + DetType_VERTEX + DetType_BARREL"/>

            <stave name="VTXIB_SEED_Stave1" r="VTXIB_SEED_curvature1" length="2.*VTXIB_SEED_half_length1-2.*Support_ring_length">
                <sensor name="sensor" thickness="VTXIB_SEED_total_sensor_thickness" material="Silicon">
                    <component sensitive="True"  isCurved="true" name="Pixel array"   vis="VTXSensitiveVis" xmin="0." xmax="VTXIB_SEED_sensor_phi_sensitive" ymin="-VTXIB_SEED_sensor_z/2.+VTXIB_SEED_sensor_z_periphery/2." ymax="+VTXIB_SEED_sensor_z/2.-VTXIB_SEED_sensor_z_periphery/2." sensor_insensitive_thickness_below="VTXIB_SEED_insensitive_thickness_below" thickness="VTXIB_SEED_sensitive_thickness" sensor_insensitive_thickness_above="VTXIB_SEED_insensitive_thickness_above" other_insensitive_thickness_below="VTXIB_SEED_Kapton_beampipe_thickness" other_insensitive_thickness_above="0." nsegments="VTXIB_curved_nsegments"/>
                    <component sensitive="False" isCurved="true" name="Periphery_phi" vis="VTXPeripheryVis" xmin="VTXIB_SEED_sensor_phi_sensitive" xmax="VTXIB_SEED_sensor_phi" ymin="-VTXIB_SEED_sensor_z/2.+VTXIB_SEED_sensor_z_periphery/2." ymax="+VTXIB_SEED_sensor_z/2.-VTXIB_SEED_sensor_z_periphery/2."/>
                    <component sensitive="False" isCurved="true" name="Periphery_z1"  vis="VTXPeripheryVis" xmin="0." xmax="VTXIB_SEED_sensor_phi" ymin="-VTXIB_SEED_sensor_z/2." ymax="-VTXIB_SEED_sensor_z/2.+VTXIB_SEED_sensor_z_periphery/2."/>
                    <component sensitive="False" isCurved="true" name="Periphery_z2"  vis="VTXPeripheryVis" xmin="0." xmax="VTXIB_SEED_sensor_phi" ymin="+VTXIB_SEED_sensor_z/2.-VTXIB_SEED_sensor_z_periphery/2." ymax="+VTXIB_SEED_sensor_z/2."/>
                </sensor>
            
                <components name="Support_longeron_between_sensors" r="Support_longeron_betweenSensors_offset_r1" length="VTXIB_SEED_half_length1-Support_ring_length"> <!-- In the first layer make the support a bit thinner and split it into multiple segments, and make it 5% less wide to avoid overlaps --> 
                    <component sensitive="False" isCurved="true" vis="CarbonVis" material="CarbonFoam" thickness="0.75*Support_longeron_betweenSensors_thickness" width="Support_longeron_betweenSensors_width/3.*0.95" r="0.25*Support_longeron_betweenSensors_thickness" phi_offset="Support_longeron_betweenSensors_phi1_1"/>
                    <component sensitive="False" isCurved="true" vis="CarbonVis" material="CarbonFoam" thickness="0.45*Support_longeron_betweenSensors_thickness" width="Support_longeron_betweenSensors_width/3.*0.95" r="0.55*Support_longeron_betweenSensors_thickness" phi_offset="Support_longeron_betweenSensors_phi1_2"/>
                    <component sensitive="False" isCurved="true" vis="CarbonVis" material="CarbonFoam" thickness="0.1*Support_longeron_betweenSensors_thickness" width="Support_longeron_betweenSensors_width/3.*0.95" r="0.9*Support_longeron_betweenSensors_thickness" phi_offset="Support_longeron_betweenSensors_phi1_3"/>
                </components>

                <components name="Support_longeron_between_layers" r="Support_longeron_betweenLayers_offset_r1" length="VTXIB_SEED_half_length1-Support_ring_length">
                    <component sensitive="False" isCurved="true" vis="VTXCarbonFoamVis" material="CarbonFoam" thickness="Support_longeron_betweenLayers_thickness1" width="VTXIB_SEED_sensor_phi_periphery" phi_offset="Flex_offset_phi1"/>
                </components>

                <components name="flex" length="VTXIB_SEED_half_length1">
                    <component sensitive="False" isCurved="true" name="Aluminium" vis="FlexVis"   material="Aluminum" thickness="Flex_Al_thickness"     width="Flex_width" phi_offset="Flex_offset_phi1"/>
                    <component sensitive="False" isCurved="true" name="Kapton"    vis="KaptonVis" material="Kapton"   thickness="Flex_Kapton_thickness" width="Flex_width" phi_offset="Flex_offset_phi1" r="Flex_Al_thickness"/>
                </components>

                <end_z name="end_of_stave_hybrid_flex" r="0.0*mm">
                    <component thickness="VTXIB_hybrid_thickness"      isCurved="true" width="VTXIB_hybrid_width" length="VTXIB_hybrid_length" dz="Support_ring_length" r="0.0*mm" material="PCB" vis="VTXHybridVis" phi_offset="Flex_offset_phi1-VTXIB_SEED_sensor_phi_periphery/2."/>
                    <component thickness="VTXIB_hybrid_opto_thickness" isCurved="true" width="VTXIB_hybrid_opto_width" length="VTXIB_hybrid_opto_width" dz="Support_ring_length + VTXIB_hybrid_length/2. - VTXIB_hybrid_opto_width/2." r="VTXIB_hybrid_thickness" material="Silicon" vis="OptoElVis" phi_offset="Flex_offset_phi1-VTXIB_SEED_sensor_phi_periphery/2."/>
                </end_z>

