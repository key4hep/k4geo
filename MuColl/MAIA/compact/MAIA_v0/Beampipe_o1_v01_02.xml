<lccdd>
    <!--  Definition of global dictionary constants          -->
    <define>
        <constant name="Beampipe_inner_radius" value="2.3*cm" />
        <constant name="Beampipe_outer_radius" value="2.4*cm" />
    </define>
    
    <!--  Definition of the used visualization attributes    -->
    <display>
        <vis name="BeamPipeVis" alpha="0.0" r="0.0" g="1.0" b="0.0" showDaughters="true" visible="false"/>
    </display>
    
    
    <detectors>
        <comment>Beampipe</comment>
        
        <detector name="Beampipe" type="DD4hep_Beampipe_o1_v01" insideTrackingVolume="true" nocore="true" vis="BeamPipeVis">
            <parameter crossingangle="CrossingAngle" />
            <envelope vis="BlueVis">
                <shape type="Assembly"/>
            </envelope>

            <section type="Center" start="0*mm" end="Nozzle_zmin" rMin1="Beampipe_inner_radius" rMin2="Beampipe_inner_radius" rMax1="Beampipe_outer_radius" rMax2="Beampipe_outer_radius" material="Beryllium" name="VertexInnerBe" />

            <!-- Vacuum tracking the tungsten nozzle's inner bore (NozzleW_right/left); no separate wall (rMin==rMax). -->
            <section type="Center" start="Nozzle_zmin" end="15*cm" rMin1="1*cm - env_safety" rMin2="0.6*cm - env_safety" rMax1="1*cm - env_safety" rMax2="0.6*cm - env_safety" material="Vacuum" name="NozzleBoreVacuum1" />
            <section type="Center" start="15*cm" end="100*cm" rMin1="0.6*cm - env_safety" rMin2="0.3*cm - env_safety" rMax1="0.6*cm - env_safety" rMax2="0.3*cm - env_safety" material="Vacuum" name="NozzleBoreVacuum2" />
            <section type="Center" start="100*cm" end="204.48824*cm" rMin1="0.3*cm - env_safety" rMin2="0.6124092832*cm - env_safety" rMax1="0.3*cm - env_safety" rMax2="0.6124092832*cm - env_safety" material="Vacuum" name="NozzleBoreVacuum3" />
            <section type="Center" start="204.48824*cm" end="595*cm" rMin1="0.6124092832*cm - env_safety" rMin2="1.78*cm - env_safety" rMax1="0.6124092832*cm - env_safety" rMax2="1.78*cm - env_safety" material="Vacuum" name="NozzleBoreVacuum4" />

        </detector>
        
    </detectors>
</lccdd>
