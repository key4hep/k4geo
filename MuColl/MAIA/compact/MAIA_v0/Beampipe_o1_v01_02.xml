<lccdd>
    <!--  Definition of global dictionary constants          -->
    <define>
        <constant name="Beampipe_inner_radius" value="2.3*cm" />
        <constant name="Beampipe_outer_radius" value="2.4*cm" />

        <!-- Tip of the tungsten nozzle (NozzleW_right/left in Nozzle_10deg_v0.xml).
             These must be kept in sync with the first two zplanes of that detector. -->
        <constant name="NozzleTip_zmax"       value="15*cm" />
        <constant name="NozzleTip_rmax_start" value="1*cm" />        <!-- rmax at z = Nozzle_zmin  -->
        <constant name="NozzleTip_rmin_end"   value="0.6*cm" />      <!-- rmin at z = NozzleTip_zmax -->
        <constant name="NozzleTip_rmax_end"   value="2.58694*cm" />  <!-- rmax at z = NozzleTip_zmax -->

        <!-- Inner bore of the nozzle beyond the tip: the rmin zplanes of NozzleW_right/left.
             Same z breakpoints as that polycone, so the two surfaces stay parallel. -->
        <constant name="NozzleBore_zkink" value="100*cm" />
        <constant name="NozzleBore_zmid"  value="204.48824*cm" />
        <constant name="NozzleBore_zend"  value="595*cm" />
        <constant name="NozzleBore_rkink" value="0.3*cm" />
        <constant name="NozzleBore_rmid"  value="0.6124092832*cm" />
        <constant name="NozzleBore_rend"  value="1.78*cm" />

        <!-- Slope of the nozzle tip's outer surface, and the z at which that surface
             reaches the inner / outer radius of the beam pipe wall. The wall runs up to
             the first of these and is then closed off by a conical section that follows
             the nozzle, so that pipe and nozzle join without a gap. The env_safety
             offset keeps the Be away from the W by ~2 um in r. -->
        <constant name="NozzleTip_slope"      value="(NozzleTip_rmax_end - NozzleTip_rmax_start)/(NozzleTip_zmax - Nozzle_zmin)" />
        <constant name="Beampipe_wall_zjoint" value="Nozzle_zmin + (Beampipe_inner_radius - NozzleTip_rmax_start)/NozzleTip_slope - env_safety" />
        <constant name="Beampipe_wall_zend"   value="Nozzle_zmin + (Beampipe_outer_radius - NozzleTip_rmax_start)/NozzleTip_slope - env_safety" />
    </define>
    
    <!--  Definition of the used visualization attributes    -->
    <display>
        <vis name="BeamPipeVis" alpha="0.0" r="0.0" g="1.0" b="0.0" showDaughters="true" visible="false"/>
    </display>
    
    
    <detectors>
        <comment>Beampipe</comment>
        
        <detector name="Beampipe" type="DD4hep_Beampipe_o1_v01" insideTrackingVolume="true" nocore="true" vis="BeamPipeVis">
            <parameter crossingangle="CrossingAngle" />
            <envelope vis="BlueVis">
                <shape type="Assembly"/>
            </envelope>

            <!-- Cylindrical part of the wall: from the IP up to the point where the outer
                 surface of the nozzle tip reaches Beampipe_inner_radius. -->
            <section type="Center" start="0*mm" end="Beampipe_wall_zjoint" rMin1="Beampipe_inner_radius" rMin2="Beampipe_inner_radius" rMax1="Beampipe_outer_radius" rMax2="Beampipe_outer_radius" material="Beryllium" name="VertexInnerBe" />

            <!-- Conical closing section: the inner surface follows the nozzle tip until the
                 wall has been fully absorbed by it at Beampipe_wall_zend. -->
            <section type="Center" start="Beampipe_wall_zjoint" end="Beampipe_wall_zend" rMin1="Beampipe_inner_radius" rMin2="Beampipe_outer_radius" rMax1="Beampipe_outer_radius" rMax2="Beampipe_outer_radius" material="Beryllium" name="VertexInnerBeNozzleJoint" />

            <!-- NOTE: the driver (DD4hep_Beampipe_o1_v01) only ever builds the *wall* of a
                 section; with nocore="true" the inside is left to the mother volume. The
                 volume inside the pipe is therefore built explicitly below. -->

        </detector>

        <!-- Everything inside the beam pipe, from -NozzleTip_zmax to +NozzleTip_zmax,
             filled with the "beam" material: a tube of radius Beampipe_inner_radius from
             which both tungsten nozzle tips are subtracted, so each nozzle sits fully
             inside it and the bore through the nozzle stays part of the beam volume.
             Built as a single volume so that no geometry boundary sits at the IP. -->
        <detector name="BeampipeCore" type="MaterialEnvelope_o1_v01" vis="BeamPipeVis">
            <envelope vis="BlueVis">
                <shape type="BooleanShape" operation="Subtraction" material="beam">
                    <shape type="BooleanShape" operation="Subtraction">
                        <shape type="Tube" rmin="0" rmax="Beampipe_inner_radius" dz="NozzleTip_zmax"/>
                        <shape type="Cone" rmin1="NozzleTip_rmax_start - env_safety" rmax1="NozzleTip_rmax_start + env_safety" rmin2="NozzleTip_rmin_end - env_safety" rmax2="NozzleTip_rmax_end + env_safety" z="(NozzleTip_zmax - Nozzle_zmin)/2"/>
                        <position x="0" y="0" z="(Nozzle_zmin + NozzleTip_zmax)/2"/>
                    </shape>
                    <!-- -z tip: Cone z1/z2 ends swapped so a plain translation lands each end correctly -->
                    <shape type="Cone" rmin1="NozzleTip_rmin_end - env_safety" rmax1="NozzleTip_rmax_end + env_safety" rmin2="NozzleTip_rmax_start - env_safety" rmax2="NozzleTip_rmax_start + env_safety" z="(NozzleTip_zmax - Nozzle_zmin)/2"/>
                    <position x="0" y="0" z="-(Nozzle_zmin + NozzleTip_zmax)/2"/>
                </shape>
                <position x="0" y="0" z="0"/>
            </envelope>
        </detector>


        <!-- Beam volume inside the bore of the nozzle, from the end of the nozzle tip
             (where it joins BeampipeCore) out to the end of the nozzle. rmax follows the
             nozzle's rmin, inset by env_safety so the two never touch. -->
        <detector name="BeampipeBore_right" type="DD4hep_PolyconeSupport" vis="BeamPipeVis">
            <material name="beam"/>
            <zplane z="NozzleTip_zmax"   rmin="0" rmax="NozzleTip_rmin_end - env_safety" />
            <zplane z="NozzleBore_zkink" rmin="0" rmax="NozzleBore_rkink - env_safety" />
            <zplane z="NozzleBore_zmid"  rmin="0" rmax="NozzleBore_rmid - env_safety" />
            <zplane z="NozzleBore_zend"  rmin="0" rmax="NozzleBore_rend - env_safety" />
        </detector>

        <detector name="BeampipeBore_left" type="DD4hep_PolyconeSupport" vis="BeamPipeVis">
            <material name="beam"/>
            <zplane z="-NozzleTip_zmax"   rmin="0" rmax="NozzleTip_rmin_end - env_safety" />
            <zplane z="-NozzleBore_zkink" rmin="0" rmax="NozzleBore_rkink - env_safety" />
            <zplane z="-NozzleBore_zmid"  rmin="0" rmax="NozzleBore_rmid - env_safety" />
            <zplane z="-NozzleBore_zend"  rmin="0" rmax="NozzleBore_rend - env_safety" />
        </detector>

    </detectors>
</lccdd>
