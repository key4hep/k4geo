<lccdd>
    <!--  Definition of global dictionary constants          -->
    <define>
        <constant name="Nozzle_kink_z"    value="100*cm"/>
        <constant name="NozzleCut_halfgap" value="25*mm"/>
    </define>

    <!--  Definition of the used visualization attributes    -->
    <display>
        <vis name="NozzleWVis"     alpha="1.0" r="0.0" g="1.0" b="1.0" showDaughters="true" visible="true"/>
        <vis name="NozzleBCHVis"   alpha="1.0" r="0.3" g="0.3" b="1.0" showDaughters="true" visible="true"/>
        <vis name="NozzleSteelVis" alpha="1.0" r="0.7" g="0.7" b="0.7" showDaughters="true" visible="true"/>
    </display>


    <detectors>
        <comment>Nozzle: new version for 10 TeV Muon Collider</comment>

        <!-- ======================================================= -->
        <!-- Tungsten core (right side), 4 segments separated by      -->
        <!-- 5 cm Si-detector gaps at z = 545, 565, 585 cm            -->
        <!-- ======================================================= -->

        <detector name="NozzleW_right" type="DD4hep_PolyconeSupport" vis="NozzleWVis" region="NozzleRegion">
            <comment>Tungsten core, segment z = 6 to 542.5 cm</comment>
            <material name="Tungsten_light"/>
            <zplane z="Nozzle_zmin"        rmin="1*cm"             rmax="1*cm" />
            <zplane z="15*cm"              rmin="0.6*cm"           rmax="2.58694*cm" />
            <zplane z="Nozzle_kink_z"      rmin="0.3*cm"           rmax="17.57473619*cm" />
            <zplane z="Nozzle_kink_z"      rmin="0.3*cm"           rmax="13.47473619*cm" />
            <zplane z="204.48824*cm"       rmin="0.6124092832*cm"  rmax="13.47473619*cm" />
            <zplane z="542.5*cm"           rmin="1.623028*cm"      rmax="39.030654*cm" />
        </detector>

        <detector name="NozzleW_right_1" type="DD4hep_PolyconeSupport" vis="NozzleWVis" region="NozzleRegion">
            <comment>Tungsten core, segment z = 547.5 to 562.5 cm</comment>
            <material name="Tungsten_light"/>
            <zplane z="547.5*cm"           rmin="1.637982*cm"      rmax="39.408687*cm" />
            <zplane z="562.5*cm"           rmin="1.682826*cm"      rmax="40.542786*cm" />
        </detector>

        <detector name="NozzleW_right_2" type="DD4hep_PolyconeSupport" vis="NozzleWVis" region="NozzleRegion">
            <comment>Tungsten core, segment z = 567.5 to 582.5 cm</comment>
            <material name="Tungsten_light"/>
            <zplane z="567.5*cm"           rmin="1.697780*cm"      rmax="40.920818*cm" />
            <zplane z="582.5*cm"           rmin="1.742624*cm"      rmax="42.054918*cm" />
        </detector>

        <detector name="NozzleW_right_3" type="DD4hep_PolyconeSupport" vis="NozzleWVis" region="NozzleRegion">
            <comment>Tungsten core, segment z = 587.5 to 595 cm</comment>
            <material name="Tungsten_light"/>
            <zplane z="587.5*cm"           rmin="1.757578*cm"      rmax="42.432950*cm" />
            <zplane z="595*cm"             rmin="1.78*cm"           rmax="43*cm" />
        </detector>


        <!-- ======================================================= -->
        <!-- Tungsten core (left side)                                -->
        <!-- ======================================================= -->

        <detector name="NozzleW_left" type="DD4hep_PolyconeSupport" vis="NozzleWVis" region="NozzleRegion">
            <comment>Tungsten core, segment z = -6 to -542.5 cm</comment>
            <material name="Tungsten_light"/>
            <zplane z="-Nozzle_zmin"       rmin="1*cm"             rmax="1*cm" />
            <zplane z="-15*cm"             rmin="0.6*cm"           rmax="2.58694*cm" />
            <zplane z="-Nozzle_kink_z"     rmin="0.3*cm"           rmax="17.57473619*cm" />
            <zplane z="-Nozzle_kink_z"     rmin="0.3*cm"           rmax="13.47473619*cm" />
            <zplane z="-204.48824*cm"      rmin="0.6124092832*cm"  rmax="13.47473619*cm" />
            <zplane z="-542.5*cm"          rmin="1.623028*cm"      rmax="39.030654*cm" />
        </detector>

        <detector name="NozzleW_left_1" type="DD4hep_PolyconeSupport" vis="NozzleWVis" region="NozzleRegion">
            <comment>Tungsten core, segment z = -547.5 to -562.5 cm</comment>
            <material name="Tungsten_light"/>
            <zplane z="-547.5*cm"          rmin="1.637982*cm"      rmax="39.408687*cm" />
            <zplane z="-562.5*cm"          rmin="1.682826*cm"      rmax="40.542786*cm" />
        </detector>

        <detector name="NozzleW_left_2" type="DD4hep_PolyconeSupport" vis="NozzleWVis" region="NozzleRegion">
            <comment>Tungsten core, segment z = -567.5 to -582.5 cm</comment>
            <material name="Tungsten_light"/>
            <zplane z="-567.5*cm"          rmin="1.697780*cm"      rmax="40.920818*cm" />
            <zplane z="-582.5*cm"          rmin="1.742624*cm"      rmax="42.054918*cm" />
        </detector>

        <detector name="NozzleW_left_3" type="DD4hep_PolyconeSupport" vis="NozzleWVis" region="NozzleRegion">
            <comment>Tungsten core, segment z = -587.5 to -595 cm</comment>
            <material name="Tungsten_light"/>
            <zplane z="-587.5*cm"          rmin="1.757578*cm"      rmax="42.432950*cm" />
            <zplane z="-595*cm"            rmin="1.78*cm"           rmax="43*cm" />
        </detector>


        <!-- ======================================================= -->
        <!-- Borated polyethylene middle layer (right side)           -->
        <!-- ======================================================= -->

        <detector name="NozzleBCH_right" type="DD4hep_PolyconeSupport" vis="NozzleBCHVis" region="NozzleRegion">
            <comment>Borated polyethylene, segment z = 100 to 542.5 cm</comment>
            <material name="BCH2_composite"/>
            <zplane z="Nozzle_kink_z"      rmin="13.48473619*cm"   rmax="13.57473619*cm" />
            <zplane z="204.48824*cm"       rmin="13.48473619*cm"   rmax="21.39584482*cm" />
            <zplane z="542.5*cm"           rmin="39.040654*cm"     rmax="47.020048*cm" />
        </detector>

        <detector name="NozzleBCH_right_1" type="DD4hep_PolyconeSupport" vis="NozzleBCHVis" region="NozzleRegion">
            <comment>Borated polyethylene, segment z = 547.5 to 562.5 cm</comment>
            <material name="BCH2_composite"/>
            <zplane z="547.5*cm"           rmin="39.418687*cm"     rmax="47.399091*cm" />
            <zplane z="562.5*cm"           rmin="40.552786*cm"     rmax="48.536220*cm" />
        </detector>

        <detector name="NozzleBCH_right_2" type="DD4hep_PolyconeSupport" vis="NozzleBCHVis" region="NozzleRegion">
            <comment>Borated polyethylene, segment z = 567.5 to 582.5 cm</comment>
            <material name="BCH2_composite"/>
            <zplane z="567.5*cm"           rmin="40.930818*cm"     rmax="48.915263*cm" />
            <zplane z="582.5*cm"           rmin="42.064918*cm"     rmax="50.052393*cm" />
        </detector>

        <detector name="NozzleBCH_right_3" type="DD4hep_PolyconeSupport" vis="NozzleBCHVis" region="NozzleRegion">
            <comment>Borated polyethylene, segment z = 587.5 to 595 cm</comment>
            <material name="BCH2_composite"/>
            <zplane z="587.5*cm"           rmin="42.442950*cm"     rmax="50.431435*cm" />
            <zplane z="595*cm"             rmin="43.01*cm"          rmax="51*cm" />
        </detector>


        <!-- ======================================================= -->
        <!-- Borated polyethylene middle layer (left side)            -->
        <!-- ======================================================= -->

        <detector name="NozzleBCH_left" type="DD4hep_PolyconeSupport" vis="NozzleBCHVis" region="NozzleRegion">
            <comment>Borated polyethylene, segment z = -100 to -542.5 cm</comment>
            <material name="BCH2_composite"/>
            <zplane z="-Nozzle_kink_z"     rmin="13.48473619*cm"   rmax="13.57473619*cm" />
            <zplane z="-204.48824*cm"      rmin="13.48473619*cm"   rmax="21.39584482*cm" />
            <zplane z="-542.5*cm"          rmin="39.040654*cm"     rmax="47.020048*cm" />
        </detector>

        <detector name="NozzleBCH_left_1" type="DD4hep_PolyconeSupport" vis="NozzleBCHVis" region="NozzleRegion">
            <comment>Borated polyethylene, segment z = -547.5 to -562.5 cm</comment>
            <material name="BCH2_composite"/>
            <zplane z="-547.5*cm"          rmin="39.418687*cm"     rmax="47.399091*cm" />
            <zplane z="-562.5*cm"          rmin="40.552786*cm"     rmax="48.536220*cm" />
        </detector>

        <detector name="NozzleBCH_left_2" type="DD4hep_PolyconeSupport" vis="NozzleBCHVis" region="NozzleRegion">
            <comment>Borated polyethylene, segment z = -567.5 to -582.5 cm</comment>
            <material name="BCH2_composite"/>
            <zplane z="-567.5*cm"          rmin="40.930818*cm"     rmax="48.915263*cm" />
            <zplane z="-582.5*cm"          rmin="42.064918*cm"     rmax="50.052393*cm" />
        </detector>

        <detector name="NozzleBCH_left_3" type="DD4hep_PolyconeSupport" vis="NozzleBCHVis" region="NozzleRegion">
            <comment>Borated polyethylene, segment z = -587.5 to -595 cm</comment>
            <material name="BCH2_composite"/>
            <zplane z="-587.5*cm"          rmin="42.442950*cm"     rmax="50.431435*cm" />
            <zplane z="-595*cm"            rmin="43.01*cm"          rmax="51*cm" />
        </detector>


        <!-- ======================================================= -->
        <!-- Tungsten cladding (right side)                           -->
        <!-- ======================================================= -->

        <detector name="NozzleWCludding_right" type="DD4hep_PolyconeSupport" vis="NozzleWVis" region="NozzleRegion">
            <comment>Tungsten cladding, segment z = 100 to 542.5 cm</comment>
            <material name="Tungsten_light"/>
            <zplane z="Nozzle_kink_z"      rmin="13.57473619*cm"   rmax="17.57473619*cm" />
            <zplane z="542.5*cm"           rmin="47.030654*cm"     rmax="51.030654*cm" />
        </detector>

        <detector name="NozzleWCludding_right_1" type="DD4hep_PolyconeSupport" vis="NozzleWVis" region="NozzleRegion">
            <comment>Tungsten cladding, segment z = 547.5 to 562.5 cm</comment>
            <material name="Tungsten_light"/>
            <zplane z="547.5*cm"           rmin="47.408687*cm"     rmax="51.408687*cm" />
            <zplane z="562.5*cm"           rmin="48.542786*cm"     rmax="52.542786*cm" />
        </detector>

        <detector name="NozzleWCludding_right_2" type="DD4hep_PolyconeSupport" vis="NozzleWVis" region="NozzleRegion">
            <comment>Tungsten cladding, segment z = 567.5 to 582.5 cm</comment>
            <material name="Tungsten_light"/>
            <zplane z="567.5*cm"           rmin="48.920818*cm"     rmax="52.920818*cm" />
            <zplane z="582.5*cm"           rmin="50.054918*cm"     rmax="54.054918*cm" />
        </detector>

        <detector name="NozzleWCludding_right_3" type="DD4hep_PolyconeSupport" vis="NozzleWVis" region="NozzleRegion">
            <comment>Tungsten cladding, segment z = 587.5 to 595 cm</comment>
            <material name="Tungsten_light"/>
            <zplane z="587.5*cm"           rmin="50.432950*cm"     rmax="54.432950*cm" />
            <zplane z="595*cm"             rmin="51*cm"             rmax="55*cm" />
        </detector>


        <!-- ======================================================= -->
        <!-- Tungsten cladding (left side)                            -->
        <!-- ======================================================= -->

        <detector name="NozzleWCludding_left" type="DD4hep_PolyconeSupport" vis="NozzleWVis" region="NozzleRegion">
            <comment>Tungsten cladding, segment z = -100 to -542.5 cm</comment>
            <material name="Tungsten_light"/>
            <zplane z="-Nozzle_kink_z"     rmin="13.57473619*cm"   rmax="17.57473619*cm" />
            <zplane z="-542.5*cm"          rmin="47.030654*cm"     rmax="51.030654*cm" />
        </detector>

        <detector name="NozzleWCludding_left_1" type="DD4hep_PolyconeSupport" vis="NozzleWVis" region="NozzleRegion">
            <comment>Tungsten cladding, segment z = -547.5 to -562.5 cm</comment>
            <material name="Tungsten_light"/>
            <zplane z="-547.5*cm"          rmin="47.408687*cm"     rmax="51.408687*cm" />
            <zplane z="-562.5*cm"          rmin="48.542786*cm"     rmax="52.542786*cm" />
        </detector>

        <detector name="NozzleWCludding_left_2" type="DD4hep_PolyconeSupport" vis="NozzleWVis" region="NozzleRegion">
            <comment>Tungsten cladding, segment z = -567.5 to -582.5 cm</comment>
            <material name="Tungsten_light"/>
            <zplane z="-567.5*cm"          rmin="48.920818*cm"     rmax="52.920818*cm" />
            <zplane z="-582.5*cm"          rmin="50.054918*cm"     rmax="54.054918*cm" />
        </detector>

        <detector name="NozzleWCludding_left_3" type="DD4hep_PolyconeSupport" vis="NozzleWVis" region="NozzleRegion">
            <comment>Tungsten cladding, segment z = -587.5 to -595 cm</comment>
            <material name="Tungsten_light"/>
            <zplane z="-587.5*cm"          rmin="50.432950*cm"     rmax="54.432950*cm" />
            <zplane z="-595*cm"            rmin="51*cm"             rmax="55*cm" />
        </detector>


        <!-- ======================================================= -->
        <!-- Steel inserts in the three nozzle gaps                   -->
        <!-- 5 cm long, 5 mm thick tubes seated at the nozzle bore    -->
        <!-- to isolate the vacuum across each Forward Tracker gap.   -->
        <!-- Inner radius = NozzleW bore at the gap boundaries,       -->
        <!-- so the bore profile is continuous across the gap.        -->
        <!-- ======================================================= -->

        <detector name="NozzleSteelInsert_right_0" type="DD4hep_PolyconeSupport" vis="NozzleSteelVis" region="NozzleRegion">
            <comment>Steel vacuum tube, gap 1 (z = 542.5 to 547.5 cm)</comment>
            <material name="Steel235"/>
            <zplane z="542.5*cm"           rmin="1.623028*cm"      rmax="2.123028*cm" />
            <zplane z="547.5*cm"           rmin="1.637982*cm"      rmax="2.137982*cm" />
        </detector>

        <detector name="NozzleSteelInsert_right_1" type="DD4hep_PolyconeSupport" vis="NozzleSteelVis" region="NozzleRegion">
            <comment>Steel vacuum tube, gap 2 (z = 562.5 to 567.5 cm)</comment>
            <material name="Steel235"/>
            <zplane z="562.5*cm"           rmin="1.682826*cm"      rmax="2.182826*cm" />
            <zplane z="567.5*cm"           rmin="1.697780*cm"      rmax="2.197780*cm" />
        </detector>

        <detector name="NozzleSteelInsert_right_2" type="DD4hep_PolyconeSupport" vis="NozzleSteelVis" region="NozzleRegion">
            <comment>Steel vacuum tube, gap 3 (z = 582.5 to 587.5 cm)</comment>
            <material name="Steel235"/>
            <zplane z="582.5*cm"           rmin="1.742624*cm"      rmax="2.242624*cm" />
            <zplane z="587.5*cm"           rmin="1.757578*cm"      rmax="2.257578*cm" />
        </detector>

        <detector name="NozzleSteelInsert_left_0" type="DD4hep_PolyconeSupport" vis="NozzleSteelVis" region="NozzleRegion">
            <comment>Steel vacuum tube, gap 1 (z = -547.5 to -542.5 cm)</comment>
            <material name="Steel235"/>
            <zplane z="-547.5*cm"          rmin="1.637982*cm"      rmax="2.137982*cm" />
            <zplane z="-542.5*cm"          rmin="1.623028*cm"      rmax="2.123028*cm" />
        </detector>

        <detector name="NozzleSteelInsert_left_1" type="DD4hep_PolyconeSupport" vis="NozzleSteelVis" region="NozzleRegion">
            <comment>Steel vacuum tube, gap 2 (z = -567.5 to -562.5 cm)</comment>
            <material name="Steel235"/>
            <zplane z="-567.5*cm"          rmin="1.697780*cm"      rmax="2.197780*cm" />
            <zplane z="-562.5*cm"          rmin="1.682826*cm"      rmax="2.182826*cm" />
        </detector>

        <detector name="NozzleSteelInsert_left_2" type="DD4hep_PolyconeSupport" vis="NozzleSteelVis" region="NozzleRegion">
            <comment>Steel vacuum tube, gap 3 (z = -587.5 to -582.5 cm)</comment>
            <material name="Steel235"/>
            <zplane z="-587.5*cm"          rmin="1.757578*cm"      rmax="2.257578*cm" />
            <zplane z="-582.5*cm"          rmin="1.742624*cm"      rmax="2.242624*cm" />
        </detector>

    </detectors>
</lccdd>
