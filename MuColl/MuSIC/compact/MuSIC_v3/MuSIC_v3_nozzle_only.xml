<lccdd>
    <info name="MuSIC_v3_nozzle_only"
          title="MuSIC v3 nozzle-only geometry for visualization"
          author="Massimo Casarsa"
          status="development"
          version="$Id$">
        <comment>Standalone nozzle compact: loads Nozzle_10deg_v2.xml and ForwardTracker.xml for visualization.</comment>
    </info>

    <includes>
        <gdmlFile  ref="elements.xml"/>
        <gdmlFile  ref="materials.xml"/>
    </includes>

    <define>
        <constant name="world_side"  value="14000*mm"/>
        <constant name="world_x"     value="world_side"/>
        <constant name="world_y"     value="world_side"/>
        <constant name="world_z"     value="world_side"/>

        <constant name="Nozzle_zmin"            value="6*cm"/>
        <constant name="Nozzle_zmax"            value="600*cm"/>
        <constant name="DetID_FT"               value="7"/>
        <constant name="GlobalTrackerReadoutID" type="string" value="system:5,side:-2,layer:6,module:11,sensor:8"/>
    </define>

    <regions>
        <region name="NozzleRegion"/>
    </regions>

    <include ref="${DD4hepINSTALL}/DDDetectors/compact/detector_types.xml"/>

    <include ref="Nozzle_10deg_v2.xml"/>
    <include ref="ForwardTracker.xml"/>

</lccdd>
